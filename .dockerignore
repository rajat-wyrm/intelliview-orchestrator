# --- VCS / IDE ---
.git
.gitignore
.gitattributes
.github

# --- Local virtualenvs / caches ---
.venv
venv
**/.venv
**/venv

__pycache__
**/__pycache__
*.pyc
**/*.pyc
*.pyo
**/*.pyo
*.pyd
**/*.pyd

.mypy_cache
**/.mypy_cache
.pytest_cache
**/.pytest_cache
